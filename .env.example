# 环境变量配置

# 管理员密码（系统会自动进行 SHA-256 加密）
# 推荐：多密码（逗号或换行分隔）
ADMIN_PASSWORDS=admin123,admin456

# 兼容旧版本：单密码（当 ADMIN_PASSWORDS 未设置时生效）
# ADMIN_PASSWORD=admin123

# Webhook API 密钥（用于保护邮件接收端点）
# 生产环境请使用 `openssl rand -base64 32` 生成新密钥
WEBHOOK_API_KEY=your-webhook-api-key-here

# 可选：清理过期邮件的令牌
# CLEANUP_TOKEN=your-cleanup-token

# 服务器端口（可选，默认 3000）
PORT=3303

# Web 应用访问 URL（用于 Cloudflare Worker 配置）
# 格式: http://your-server-ip:port 或 https://your-domain.com
WEB_APP_URL=http://your-server-ip:3303

# 数据库路径（默认在项目根目录）
# DATABASE_PATH=./emails.db

# 邮件过期时间（单位：分钟，默认 30 分钟）
# 邮件将在接收后的指定时间后自动删除
EMAIL_EXPIRY_MINUTES=30

# 调试模式
DEBUG=false

# 会话有效期（秒），默认 86400（24 小时）
# SESSION_TTL_SECONDS=86400

# 会话签名密钥（强烈建议在生产环境设置）
# SESSION_SECRET=replace-with-a-long-random-string
